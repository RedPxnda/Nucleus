{
  "id": "nucleus_editor",
  "version": "1.0.0",
  "name": "Nucleus (Editor)",
  "description": "Bundles the Imgui binaries and required hooks for an easy imgui setup",
  "authors": [
    "RedPxnda",
    "Smartin"
  ],
  "contact": {},
  "license": "MIT",
  "mixins": [],
